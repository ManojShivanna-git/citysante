{
  "expo": {
    "name": "Isanthe Shop",
    "slug": "isanthe-shop-owner",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.isanthe.shop",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.isanthe.shopowner",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Isanthe to scan product barcodes."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "37a33ff5-9c22-4f69-88e2-df956fcac889"
      }
    },
    "owner": "manojss"
  }
}