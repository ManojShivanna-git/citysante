{
  "expo": {
    "name": "Isanthe Shop",
    "slug": "isanthe-shop-owner",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.isanthe.shop",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.isanthe.shop",
      "versionCode": 6,
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDomYDJ9arv0ZY4DM-CYChxPTmV82QgBBw"
        }
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "icon": "./assets/icon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Isanthe to scan product barcodes."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Isanthe to use your location to pin your shop on the map."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "37a33ff5-9c22-4f69-88e2-df956fcac889"
      }
    },
    "owner": "manojss",
    "icon": "./assets/icon.png"
  }
}
