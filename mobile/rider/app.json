{
  "expo": {
    "name": "Isanthe Rider",
    "slug": "isanthe-rider",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.isanthe.rider",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Isanthe needs your location to update delivery status.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Isanthe needs your location while delivering orders."
      }
    },
    "android": {
      "package": "com.isanthe.rider",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "icon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Isanthe needs location for deliveries."
        }
      ],
      "expo-secure-store",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "2aa2b3bd-196d-46f3-af5e-6763bf88bb37"
      }
    },
    "owner": "manojss",
    "icon": "./assets/icon.png"
  }
}
